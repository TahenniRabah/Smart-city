      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - urbanhub_sensor_last_seen_epoch_seconds",
          "legendFormat": "âge"
