FROM maven:3.9-eclipse-temurin-25-alpine AS build
WORKDIR /app
COPY pom.xml .
COPY config ./config
COPY src ./src
RUN mvn clean package -DskipTests -B --no-transfer-progress

FROM alpine:3.22 AS otel
ARG OTEL_JAVA_AGENT_VERSION=2.18.1
RUN apk add --no-cache curl \
 && curl -fsSL -o /opentelemetry-javaagent.jar \
    "https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_JAVA_AGENT_VERSION}/opentelemetry-javaagent.jar"

FROM eclipse-temurin:25-jre-alpine
RUN apk add --no-cache curl \
 && addgroup -S urbanhub \
 && adduser -S urbanhub -G urbanhub
WORKDIR /app
COPY --from=build --chown=urbanhub:urbanhub /app/target/*.jar app.jar
COPY --from=otel --chown=urbanhub:urbanhub /opentelemetry-javaagent.jar /opt/opentelemetry-javaagent.jar
USER urbanhub
EXPOSE 8082
ENTRYPOINT ["java","-XX:+UseContainerSupport","-XX:MaxRAMPercentage=75.0","-jar","app.jar"]
